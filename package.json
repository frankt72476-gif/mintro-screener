{
  "name": "mintro-screener",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "validate": "tsc --build && node packages/ruleset/dist/bin/validate-ruleset.js",
    "check": "npm run typecheck && npm run test",
    "scan": "tsc --build && node packages/engine/dist/bin/scan-layer0.js",
    "render-check": "tsc --build && node apps/worker/dist/bin/render-check.js",
    "scan-full": "tsc --build && node apps/worker/dist/bin/scan.js",
    "link-runs": "node scripts/link-runs.mjs",
    "web": "npm run link-runs && npm run -w @mintro/web dev",
    "web:build": "npm run -w @mintro/web build",
    "testbed": "node apps/testbed/server.mjs",
    "auth-check": "tsc --build && node apps/worker/dist/bin/auth-check.js",
    "pdf": "npm run web:build --silent && npm run link-runs --silent && tsc --build && node apps/worker/dist/bin/report-pdf.js",
    "migrate-supabase": "tsc --build && node apps/worker/dist/bin/migrate-to-supabase.js",
    "verify-supabase": "tsc --build && node apps/worker/dist/bin/verify-supabase.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
