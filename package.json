{
  "name": "mintro-screener",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "validate": "tsc --build && node packages/ruleset/dist/bin/validate-ruleset.js",
    "check": "npm run typecheck && npm run test",
    "scan": "tsc --build && node packages/engine/dist/bin/scan-layer0.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
