{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "types": ["node"],
    // WebCrypto types. `sealed.ts` runs in both the browser and Node 20+, and DOM is where
    // TypeScript keeps CryptoKey and SubtleCrypto. No DOM API is used beyond crypto.subtle.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bin/**/*.ts"],
  "references": [{ "path": "../ruleset" }]
}
