# ---------------------------------------------------------------------------------------------
# Frontend — compiled into the browser bundle and therefore PUBLIC.
#
# Nothing secret may carry a VITE_ prefix (hard constraint 6). The anon key is not a secret: it
# is an identifier, and row-level security decides what it can reach. If you find yourself
# wanting the service key here, the logic belongs in the worker.
# ---------------------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------------
# Worker only — never prefix these with VITE_.
# ---------------------------------------------------------------------------------------------

# Same project URL as VITE_SUPABASE_URL. Separate so the worker never reads a VITE_ variable and
# nothing here depends on the frontend's environment being present.
SUPABASE_URL=

# Carries BYPASSRLS. This is why the append-only guarantees in supabase/migrations/ are triggers
# and primary keys rather than row-level policies — RLS would not stop this key, a trigger does.
SUPABASE_SERVICE_KEY=

# Optional. Defaults to `evidence`. The bucket must be private.
SUPABASE_EVIDENCE_BUCKET=

# Resend. Until the sending domain is verified (SPF + DKIM), leaving this unset selects the
# dry-run mailer, which composes a message and transmits nothing.
RESEND_API_KEY=

# Merchant screening credentials. The worker resolves a vault_ref from the credentials table
# against this vault; the reference is stored in Postgres, the secret never is (constraint 6).
VAULT_URL=
VAULT_TOKEN=
