# This is the WORKER's environment, at the repository root.
#
# The frontend has its own: `apps/web/.env`, because Vite reads the .env in its own root and not
# this one. See `apps/web/.env.example`. A VITE_ variable set only here produces a frontend that
# builds cleanly and then reports "Not connected" at runtime.
#
# ---------------------------------------------------------------------------------------------
# Frontend values — kept here too, because the local scan and PDF scripts read them.
#
# Compiled into the browser bundle and therefore PUBLIC. Nothing secret may carry a VITE_ prefix
# (hard constraint 6). The anon key is not a secret: it is an identifier, and row-level security
# decides what it can reach.
# ---------------------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public half of the credential deposit key pair (D-038). A public key in a public bundle is what
# it is for: the browser can seal a merchant login and has no way to open one.
VITE_CREDENTIAL_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------------
# Worker only — never prefix these with VITE_.
# ---------------------------------------------------------------------------------------------

# Same project URL as VITE_SUPABASE_URL. Separate so the worker never reads a VITE_ variable and
# nothing here depends on the frontend's environment being present.
SUPABASE_URL=

# Carries BYPASSRLS. This is why the append-only guarantees in supabase/migrations/ are triggers
# and primary keys rather than row-level policies — RLS would not stop this key, a trigger does.
SUPABASE_SERVICE_KEY=

# Optional. Defaults to `evidence`. The bucket must be private.
SUPABASE_EVIDENCE_BUCKET=

# Resend. `gomintro.com` is verified (SPF + DKIM). Leaving this unset selects the dry-run mailer,
# which composes a message and transmits nothing — a separate implementation rather than a flag, so
# a test send cannot be mistaken for a delivered report. Which one ran is written to `sends.mailer`.
#
# One key, both sends: the IQwallet report and the merchant invitation (D-063) select through the
# same `mailersFor()`, so setting this turns both on together.
RESEND_API_KEY=

# ---------------------------------------------------------------------------------------------
# Mail addresses.
#
# All four default sensibly and all four are overridable, so the sender for merchant invitations
# can be split from the sender for IQwallet reports without a code change. `apps/worker/src/
# addresses.ts` resolves them and the worker refuses to start on a bad one.
#
# A reply-to MAY be a no-reply address. What makes that acceptable is that both messages point the
# reader at their existing Mintro contact — a pointer, not a mailbox (D-065). An address printed
# inside the same email a reader is suspicious of verifies nothing, and it would put a personal
# address into a document built to be forwarded.
#
# There is nothing to configure: the line is copy, in apps/worker/src/contactLine.ts, and the copy
# audit fails the build if it does not reach either message.
# ---------------------------------------------------------------------------------------------

# The IQwallet report send. Defaults to reports@gomintro.com.
MAIL_FROM=
# Defaults to MAIL_FROM.
MAIL_REPLY_TO=

# The merchant invitation. Both default to the report's, so the split costs nothing until wanted.
INVITE_MAIL_FROM=
INVITE_REPLY_TO=

# ---------------------------------------------------------------------------------------------
# Where the merchant-facing comment page is served from, e.g. https://mintro.netlify.app
#
# **No default, deliberately.** Every other setting here has one because a wrong guess costs a
# retry; a wrong guess here puts a dead link in a merchant's inbox under Mintro's name, carrying
# the only token that will ever open that report. An invitation job with this unset fails and says
# so rather than sending something unusable.
# ---------------------------------------------------------------------------------------------
WEB_ORIGIN=

# Private half of the credential deposit key pair. Fly secret; never in a VITE_ variable, never
# in this repository.
#
# It is the only thing that can open a stored merchant credential. Constraint 6, as restated by
# D-038: credentials must never be recoverable from the database alone — a full dump yields
# ciphertext, and this key is not in it.
#
# LOSING IT IS UNRECOVERABLE, DELIBERATELY. Every stored credential becomes permanently unreadable
# and merchants are asked again. A recovery path would be a second route to plaintext, which is
# what the two-key design is paying to avoid. Do not add escrow "for convenience" — read D-038
# first and overturn it explicitly if you mean to.
#
# Generate a pair with: npm run make-credential-key
CREDENTIAL_PRIVATE_KEY=
