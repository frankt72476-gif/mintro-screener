  "checks": [
    {
      "id": "A-01",
      "title": "Document yields readable content by at least one path",
      "reads": {
        "documents": [
          "*"
        ]
      },
      "compares": {
        "kind": "structure",
        "subject": "readability"
      },
      "states": [
        "fail",
        "pass"
      ],
      "not_evaluable_when": [],
      "release": "v1",
      "note": "Never not_evaluable: the read was attempted and the attempt is the observation. Unreadability is a fact we established, so it is a fail here and a named not_evaluable cause for every downstream check."
    },
    {
      "id": "A-02",
      "title": "Declared page range complete (\"page N of M\")",
      "reads": {
        "documents": [
          "*"
        ],
        "fields": [
          "page_marker"
        ]
      },
      "compares": {
        "kind": "structure",
        "subject": "declared_page_range"
      },
      "states": [
        "fail",
        "pass"
      ],
      "not_evaluable_when": [
        "document_not_readable",
        "page_numbering_absent"
      ],
      "release": "v1"
    },
    {
      "id": "A-03",
      "title": "PDF not password-protected",
      "reads": {
        "documents": [
          "*"
        ]
      },
      "compares": {
        "kind": "structure",
        "subject": "encryption"
      },
      "states": [
        "fail",
        "pass"
      ],
      "not_evaluable_when": [],
      "release": "v1"
    },
    {
      "id": "A-04",
      "title": "Document carries markers of its declared type",
      "reads": {
        "documents": [
          "*"
        ]
      },
      "compares": {
        "kind": "structure",
        "subject": "type_markers"
      },
      "states": [
        "review",
        "pass"
      ],
      "not_evaluable_when": [
        "document_not_readable",
        "markers_not_searchable",
        "no_marker_set_for_type"
      ],
      "release": "v1",
      "note": "Deliberately weak. No classifier exists. It confirms a document filed in the EIN Letter slot carries CP 575 or 147C markers, which catches a W-9 in the wrong slot. It does not catch a forgery and must never be described as if it does. D-118: it may only report markers ABSENT where the searched text is complete — character-tier text or form fields. On a vision-routed page the model returns only the closed field list, so marker text cannot be in the searched set and the answer is markers_not_searchable."
    },
    {
      "id": "A-05",
      "title": "Required signature and date present",
      "reads": {
        "documents": [
          "*"
        ],
        "fields": [
          "signature_date"
        ]
      },
      "compares": {
        "kind": "presence",
        "subject": "signature_and_date"
      },
      "states": [
        "fail",
        "pass"
      ],
      "not_evaluable_when": [
        "document_not_readable",
        "signature_block_not_located"
      ],
      "release": "v1"
    },
    {
      "id": "A-06",
      "title": "Expiry date after run date",
      "reads": {
        "documents": [
          "owner_photo_id",
          "business_license"
        ],
        "fields": [
          "expiry_date"
        ]
      },
      "compares": {
        "kind": "date_against_run",
        "field": "expiry_date",
        "relation": "after"
      },
      "states": [
        "fail",
        "pass"
      ],
      "not_evaluable_when": [
        "document_not_readable",
        "expiry_not_extracted"
      ],
      "release": "v1"
    },
